anchor=top-right
layer=overlay
sort=-time
max-visible=2
default-timeout=4000
ignore-timeout=1

font=SauceCodePro Nerd Font Mono 11
width=300
height=90
outer-margin=12
margin=6
padding=10
border-size=1
border-radius=0
icons=1
max-icon-size=24
markup=1
actions=1
history=1

background-color=#191724df
text-color=#e0def4ff
border-color=#ebbcba
progress-color=over #c4a7e733

[urgency=low]
default-timeout=4000
border-color=#524f67ff

[urgency=normal]
default-timeout=4000

[urgency=critical]
default-timeout=8000
border-color=#eb6f92ff
